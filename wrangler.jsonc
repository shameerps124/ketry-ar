{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ketry-ar",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "5134bd51b7c84dffa21d960b60394932"
    },
    {
      "binding": "CODES",
      "id": "cec6ebca217b4cb8867e95b08b7d3dc9"
    }
  ]
}
