    "directory": "./public",
    "binding": "ASSETS",
    "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "d70ca9a5aa46465a9e2dec90f838c2b2"
    },
    {
  // ...
  "kv_namespaces": [
    {
      "binding": "CODES",
      "id": "cec6ebca217b4cb8867e95b08b7d3dc9"
    }
  ],
  // ...
}
